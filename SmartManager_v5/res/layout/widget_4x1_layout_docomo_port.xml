<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_centerInParent="true" android:layout_centerHorizontal="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@id/widget_background_image" android:contentDescription="@null" style="@style/Widget.Background.DayNight" />
    <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:id="@id/widget_clean_all_layout" style="@style/Widget.4x1.CleanAllLayout">
            <ImageView android:id="@id/widget_clean_all_background_image" android:src="@drawable/widget_background_radius_18" android:contentDescription="@null" style="@style/Widget.Background.Inside.DayNight" />
            <include android:id="@id/widget_clean_all_button" layout="@layout/widget_4x1_clean_all_button" />
        </FrameLayout>
        <LinearLayout android:gravity="center_vertical" android:id="@id/widget_4x1_main_body" android:layout_marginStart="@dimen/widget_default_margin_horizontal" android:layout_toStartOf="@id/widget_clean_all_layout" style="@style/Widget.4x1.MainBodyLayout">
            <LinearLayout android:orientation="vertical" style="@style/Widget.4x1.HorizontalWeight.Info.Port">
                <TextView android:id="@id/widget_4x1_storage_title" android:paddingBottom="@dimen/widget_4x1_title_padding_bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title_storage" android:maxLines="1" style="@style/Widget.4x1.TitleText.DayNight" />
                <include android:orientation="vertical" android:id="@id/widget_4x1_storage_info_layout" android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/widget_4x1_storage_info_layout" />
            </LinearLayout>
            <TextView style="@style/Widget.4x1.HorizontalWeight.TitleEnd.Port" />
            <LinearLayout android:orientation="vertical" style="@style/Widget.4x1.HorizontalWeight.Info.Port">
                <TextView android:id="@id/widget_4x1_ram_title" android:paddingBottom="@dimen/widget_4x1_title_padding_bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title_ram" android:maxLines="1" style="@style/Widget.4x1.TitleText.DayNight" />
                <include android:orientation="vertical" android:id="@id/widget_4x1_ram_info_layout" android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/widget_4x1_ram_info_layout" />
            </LinearLayout>
            <TextView style="@style/Widget.4x1.HorizontalWeight.InfoEnd.Port" />
        </LinearLayout>
        <include android:id="@id/widget_refresh_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignTop="@id/widget_4x1_main_body" android:layout_toStartOf="@id/widget_clean_all_layout" layout="@layout/widget_4x1_refresh_layout" />
    </RelativeLayout>
</RelativeLayout>
